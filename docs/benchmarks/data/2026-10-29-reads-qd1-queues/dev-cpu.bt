// Reads on one disk: size, and device latency by whether the completion ran on the issuing CPU.
tracepoint:block:block_rq_issue /args.dev == $1 && args.rwbs == "R"/ {
  @s[args.sector] = nsecs; @c[args.sector] = cpu; @bytes[args.bytes] = count(); @issue_cpu[cpu] = count();
}
tracepoint:block:block_rq_complete /args.dev == $1 && @s[args.sector] != 0/ {
  @lat_us[@c[args.sector] == cpu ? "same cpu" : "other cpu"] = avg((nsecs - @s[args.sector]) / 1000);
  @n[@c[args.sector] == cpu ? "same cpu" : "other cpu"] = count();
  @complete_cpu[cpu] = count();
  delete(@s[args.sector]); delete(@c[args.sector]);
}
END { clear(@s); clear(@c); }
