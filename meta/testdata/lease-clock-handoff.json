    {
      "name": "old_process_no_local_replica",
      "volume": 1,
      "node": 0,
      "first_epoch": 1,
      "initial_epoch": 4,
      "initial_target": 0,
      "local_replica": false,
      "steps": [
        {
          "op": "challenge",
          "nonce": 11
        },
        {
          "op": "authorized_attach",
          "actor": "own_agent",
          "only_if_target": true,
          "unless_target": false,
          "nonce": 11,
          "slot": "old",
          "expect_issued": true,
          "expect_epoch": 5,
          "expect_target": 0,
          "expect_mutation": true
        },
        {
          "op": "target_start",
          "slot": "old",
          "expect_started": true
        },
        {
          "op": "clock_fault"
        },
        {
          "op": "restart",
          "nonce": 12
        },
        {
          "op": "target_start",
          "slot": "old",
          "expect_started": false
        }
      ],
      "mutant": "accept_old_process_handoff",
      "expected_invariant": "FreshProcessEpoch"
    },
